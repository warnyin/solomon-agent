{
  "PreToolUse": [
    {
      "matcher": "Write|Edit",
      "hooks": [
        {
          "type": "command",
          "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/guard-secrets.mjs",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "Read|Glob|Grep",
      "hooks": [
        {
          "type": "command",
          "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/guard-isolation.mjs",
          "timeout": 5
        }
      ]
    },
    {
      "matcher": "Agent",
      "hooks": [
        {
          "type": "command",
          "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/guard-budget.mjs",
          "timeout": 5
        },
        {
          "type": "command",
          "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/guard-depth.mjs",
          "timeout": 5
        },
        {
          "type": "command",
          "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/guard-rate.mjs",
          "timeout": 5
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Agent",
      "hooks": [
        {
          "type": "command",
          "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/post-agent.mjs",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "Write|Edit",
      "hooks": [
        {
          "type": "command",
          "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/validate-artifact-write.mjs",
          "timeout": 10
        }
      ]
    }
  ],
  "SessionStart": [
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/session-bootstrap.mjs",
          "timeout": 15
        }
      ]
    }
  ],
  "Stop": [
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/session-report.mjs",
          "timeout": 30
        }
      ]
    }
  ]
}
