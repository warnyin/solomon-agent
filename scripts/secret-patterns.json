{
  "version": "0.1.0",
  "_note": "Round 5 #64 — versioned secret pattern library. Test fixtures in tests/security/secret-fixtures/.",
  "patterns": [
    { "name": "aws-access-key",        "regex": "AKIA[0-9A-Z]{16}",                "flags": "g", "description": "AWS access key ID" },
    { "name": "gcp-service-account",   "regex": "\"type\":\\s*\"service_account\"", "flags": "g", "description": "GCP service account JSON" },
    { "name": "github-pat-classic",    "regex": "ghp_[A-Za-z0-9]{36}",              "flags": "g", "description": "GitHub classic PAT" },
    { "name": "github-pat-fine",       "regex": "github_pat_[A-Za-z0-9_]{82}",      "flags": "g", "description": "GitHub fine-grained PAT" },
    { "name": "github-oauth",          "regex": "gho_[A-Za-z0-9]{36}",              "flags": "g", "description": "GitHub OAuth" },
    { "name": "github-app",            "regex": "(?:ghs|ghu)_[A-Za-z0-9]{36}",      "flags": "g", "description": "GitHub app token" },
    { "name": "anthropic-api-key",     "regex": "sk-ant-api03-[A-Za-z0-9_-]{40,}",  "flags": "g", "description": "Anthropic Claude API key" },
    { "name": "openai-api-key",        "regex": "sk-(?:proj-)?[A-Za-z0-9]{40,}",    "flags": "g", "description": "OpenAI API key" },
    { "name": "stripe-live-key",       "regex": "sk_live_[A-Za-z0-9]{24,}",         "flags": "g", "description": "Stripe live secret key" },
    { "name": "stripe-restricted",     "regex": "rk_live_[A-Za-z0-9]{24,}",         "flags": "g", "description": "Stripe restricted key" },
    { "name": "twilio-account-sid",    "regex": "AC[a-f0-9]{32}",                   "flags": "g", "description": "Twilio account SID" },
    { "name": "slack-bot-token",       "regex": "xox[abp]-[A-Za-z0-9-]{20,}",       "flags": "g", "description": "Slack token" },
    { "name": "slack-webhook",         "regex": "https://hooks\\.slack\\.com/services/T[A-Z0-9]{8,}/B[A-Z0-9]{8,}/[A-Za-z0-9]{24}", "flags": "g", "description": "Slack incoming webhook URL" },
    { "name": "pem-private-key",       "regex": "-----BEGIN (?:RSA|EC|DSA|OPENSSH|PGP) PRIVATE KEY-----", "flags": "g", "description": "PEM private key block" }
  ]
}
